generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  googleId  String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications    Application[]
  gmailConnection GmailConnection?
  emails          Email[]

  @@map("users")
}

enum ApplicationStatus {
  APPLIED
  RECRUITER_CONTACT
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  CLOSED
}

model Application {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @db.Uuid
  companyName     String
  jobTitle        String?
  location        String?
  aiStatus        ApplicationStatus?
  userStatus      ApplicationStatus?
  userStatusSetAt DateTime?
  appliedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails  Email[]
  events  ApplicationEvent[]
  actions Action[]

  @@index([userId])
  @@map("applications")
}

enum EmailRelevanceState {
  UNPROCESSED
  RELEVANT
  IRRELEVANT
}

enum EmailMatchState {
  UNMATCHED
  MATCHED
  AMBIGUOUS
  IGNORED
}

enum EmailProcessingState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Email {
  aiProcessingResult AIProcessingResult?
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @db.Uuid
  gmailMessageId     String // stable Gmail message ID
  threadId           String? // Gmail thread ID; stored for future matching
  subject            String? // email subject header
  sender             String? // From header value
  receivedAt         DateTime? // message received timestamp
  relevanceState     EmailRelevanceState      @default(UNPROCESSED)
  matchState         EmailMatchState          @default(UNMATCHED)
  matchConfirmedBy   MatchConfirmationSource?
  processingState    EmailProcessingState     @default(PENDING)
  applicationId      String?                  @db.Uuid // nullable FK to Application
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application?       @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  events      ApplicationEvent[]
  actions     Action[]

  @@unique([userId, gmailMessageId]) // idempotency constraint
  @@index([userId])
  @@index([userId, relevanceState]) // future AI processing queue queries
  @@map("emails")
}

enum MatchConfirmationSource {
  AI_AUTO
  USER_CONFIRMED
}

enum GmailConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  REVOKED
}

enum GmailSyncStatus {
  IDLE
  SYNCING
  FAILED
}

model GmailConnection {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @unique @db.Uuid
  gmailEmail    String
  status        GmailConnectionStatus @default(NOT_CONNECTED)
  syncStatus    GmailSyncStatus       @default(IDLE)
  accessToken   String
  refreshToken  String?
  lastHistoryId String?
  lastSyncedAt  DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gmail_connections")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@map("session")
}

enum AIProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AIRelevanceDecision {
  RELEVANT
  IRRELEVANT
  UNCERTAIN
}

enum EmailCategory {
  RECRUITER
  INTERVIEW
  ASSESSMENT
  OFFER
  REJECTION
  FOLLOW_UP
  NEWSLETTER
  SPAM
}

model AIProcessingResult {
  id                String               @id @default(uuid()) @db.Uuid
  emailId           String               @unique @db.Uuid
  provider          String
  model             String
  contractVersion   String
  processingStatus  AIProcessingStatus   @default(PENDING)
  relevanceDecision AIRelevanceDecision?
  category          EmailCategory?
  confidence        Float?
  deterministic     Boolean              @default(false)

  companyName        String?
  jobTitle           String?
  recruiterName      String?
  recruiterEmail     String?
  interviewStage     String?
  interviewType      String?
  interviewDate      String?
  interviewTime      String?
  assessmentInfo     String?
  assessmentDeadline String?
  offerInfo          String?
  rejectionInfo      String?
  actionRequired     Boolean?
  requestedAction    String?
  actionDeadline     String?
  followUpRequired   Boolean?
  followUpDate       String?

  extractionConfidence Float?
  provenance           String?

  errorCategory String?
  errorDetails  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([processingStatus])
  @@map("ai_processing_results")
}

model ApplicationEvent {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  emailId       String?            @db.Uuid // nullable to allow manual events later
  type          String // e.g., 'STATE_INFERRED', 'NOTE_ADDED'
  oldState      ApplicationStatus?
  newState      ApplicationStatus?
  description   String?
  provenance    String? // to track why this event was created

  createdAt DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  email       Email?      @relation(fields: [emailId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([emailId])
  @@map("application_events")
}

model Action {
  id            String    @id @default(uuid()) @db.Uuid
  applicationId String    @db.Uuid
  emailId       String?   @db.Uuid
  type          String // e.g., 'ACTION_REQUIRED', 'FOLLOW_UP_REQUIRED'
  description   String? // e.g. "Send thank you note"
  deadline      DateTime?
  status        String    @default("PENDING") // e.g., 'PENDING', 'COMPLETED', 'DISMISSED'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  email       Email?      @relation(fields: [emailId], references: [id], onDelete: SetNull)

  notificationDeliveries NotificationDelivery[]

  @@index([applicationId])
  @@index([emailId])
  @@map("actions")
}

enum NotificationProviderType {
  DISCORD
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED_RETRYABLE
  FAILED_PERMANENT
}

model NotificationDelivery {
  id            String                   @id @default(uuid()) @db.Uuid
  actionId      String                   @db.Uuid
  provider      NotificationProviderType
  status        NotificationStatus       @default(PENDING)
  attemptCount  Int                      @default(0)
  lastAttemptAt DateTime?
  errorDetails  String?
  createdAt     DateTime                 @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, provider])
  @@index([status])
  @@map("notification_deliveries")
}
