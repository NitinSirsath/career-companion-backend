generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  googleId     String?  @unique
  name         String?
  /// Salted scrypt hash for sign-in with email and password; null when the user has none.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agendaItems         AgendaItem[]
  applications        Application[]
  gmailConnection     GmailConnection?
  emails              Email[]
  outgoingEmails      OutgoingEmail[]
  blockedSenders      BlockedSender[]
  mailReplies         MailReply[]
  aiConfiguration     AIConfiguration?
  aiSavedProviders    AISavedProvider[]
  aiBatches           AIBatch[]
  aiUsageDays         AIUsageDay[]
  integrationTokens   IntegrationToken[]
  externalSubmissions ExternalSubmission[]
  notSubmittedJobs    NotSubmittedJob[]
  sandboxMessages     SandboxMessage[]
  dashboardAITip      DashboardAITip?

  @@map("users")
}

/// One failed sign-in with email and password. Kept only for the short window in which tries
/// are counted (services/passwordLogin.ts). Never holds a password.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

enum ApplicationStatus {
  APPLIED
  RECRUITER_CONTACT
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  CLOSED
}

model Application {
  archivedAt         DateTime?
  archiveRevision    Int                @default(0)
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  companyName        String
  jobTitle           String?
  location           String?
  aiStatus           ApplicationStatus?
  userStatus         ApplicationStatus?
  userStatusSetAt    DateTime?
  /// Manual-correction revision (S6-01). Changed only by user status set/clear; never by AI.
  userStatusRevision Int                @default(0)
  appliedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  agendaItems         AgendaItem[]
  emails              Email[]
  events              ApplicationEvent[]
  statusChanges       StatusChange[]
  actions             Action[]
  externalSubmissions ExternalSubmission[]

  @@index([userId])
  @@map("applications")
}

enum EmailRelevanceState {
  UNPROCESSED
  RELEVANT
  IRRELEVANT
}

enum EmailMatchState {
  UNMATCHED
  MATCHED
  AMBIGUOUS
  IGNORED
}

enum EmailProcessingState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// The user's own answer to what an email asks for: handled, or asked again after a reply.
enum EmailRequestState {
  DONE
  OPEN
}

/// How the user does what a job mail asks (owner, 24 Oct 2026): by answering the mail, or
/// somewhere else such as a form, a test or a portal.
enum AskKind {
  REPLY_BY_MAIL
  OUTSIDE_MAIL
}

/// Why a mail's request closed. Reopen clears it.
enum RequestClosedReason {
  /// A newer mail of the conversation replaced or moved past it.
  REPLACED_BY_MAIL
  /// A newer mail confirmed the user already did it ("thanks, we received your form").
  CONFIRMED_BY_MAIL
  /// The user's own reply answered it.
  YOUR_REPLY
  /// The user said they did it ("I did this").
  YOU_SAID_DONE
  /// The user set the application to Rejected or Closed.
  APPLICATION_CLOSED
}

model Email {
  aiOperations             AIOperation[]
  aiProcessingResult       AIProcessingResult?
  id                       String                   @id @default(uuid()) @db.Uuid
  userId                   String                   @db.Uuid
  gmailMessageId           String // stable Gmail message ID
  threadId                 String? // Gmail thread ID; stored for future matching
  subject                  String? // email subject header
  sender                   String? // From header value
  receivedAt               DateTime? // message received timestamp
  relevanceState           EmailRelevanceState      @default(UNPROCESSED)
  matchState               EmailMatchState          @default(UNMATCHED)
  matchConfirmedBy         MatchConfirmationSource?
  processingState          EmailProcessingState     @default(PENDING)
  processingErrorCategory  String?
  processingErrorDetails   String?
  processingErrorStage     String?
  processingRetryable      Boolean?
  processingFailedAt       DateTime?
  /// When the user first opened this email's conversation. Null shows the conversation as new.
  seenAt                   DateTime?
  /// Set only by the user, for the request this email makes. Null means the user gave no answer.
  requestUserState         EmailRequestState?
  requestUserStateAt       DateTime?
  /// Set when something closed this email's request by itself or the user said it is done, with
  /// when and, for a mail or a reply, that message's Gmail ID. Reopen clears all three.
  requestClosedReason      RequestClosedReason?
  requestClosedAt          DateTime?
  requestClosedByMessageId String?
  applicationId            String?                  @db.Uuid // nullable FK to Application
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application?       @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  agendaItems   AgendaItem[]
  events        ApplicationEvent[]
  statusChanges StatusChange[]
  actions       Action[]

  @@unique([userId, gmailMessageId]) // idempotency constraint
  @@index([userId])
  @@index([userId, relevanceState]) // future AI processing queue queries
  @@index([userId, threadId]) // conversation grouping
  @@map("emails")
}

/// A message the user sent in a conversation we already hold. Only its IDs and time are stored,
/// to show that the user replied. It is never classified, matched or sent to AI.
/// Whether the AI read the user's own reply to see which open asks it settles (owner, 24 Oct 2026).
enum ReplyReadState {
  /// The conversation had an open ask when it was sent: the AI reads it.
  WAITING
  /// Read. What it settled is closed (YOUR_REPLY).
  READ
  /// The AI could not read it (not set up, a key problem, or no answer after three tries).
  NOT_READ
}

model OutgoingEmail {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @db.Uuid
  gmailMessageId String
  threadId       String
  sentAt         DateTime
  createdAt      DateTime        @default(now())
  /// Null: nothing was open in the conversation when it was sent, so it is not read. The text
  /// itself is never stored.
  replyReadState ReplyReadState?
  replyReadTries Int             @default(0)
  replyReadAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gmailMessageId])
  @@index([userId, threadId])
  @@map("outgoing_emails")
}

/// One reply the user sent from the app, kept so that the same reply is never sent twice. The row
/// is written before the send call; `gmailMessageId` and `sentAt` are set once Gmail confirmed the
/// mail. A row without them is a send whose outcome is not known. No text is ever stored here.
model MailReply {
  userId         String    @db.Uuid
  /// Made by the page for this one reply.
  id             String    @db.Uuid
  threadId       String
  gmailMessageId String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@map("mail_replies")
}

/// One message in a dev-mode user's sandbox mailbox, which stands in for their Gmail account
/// (services/sandbox). It holds mail text, so only dev mode writes here: in prod it stays empty.
model SandboxMessage {
  /// Gmail-style message ID.
  id           String   @id
  userId       String   @db.Uuid
  /// The ID of the conversation's first message, as in Gmail.
  threadId     String
  /// Place in the mailbox's history: one higher with every message of this user.
  historyId    Int
  labelIds     String[]
  /// From and To headers.
  sender       String
  recipient    String
  /// Cc header: the other people on the mail, as typed. Null when there are none.
  cc           String?
  subject      String
  /// Message-ID header, and those of the earlier mails this one answers.
  messageId    String
  inReplyTo    String?
  referenceIds String?
  /// Plain text. The HTML part is built from it when the message is read.
  body         String
  internalDate DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, historyId])
  @@index([userId, threadId])
  @@map("sandbox_messages")
}

enum MatchConfirmationSource {
  AI_AUTO
  USER_CONFIRMED
}

enum GmailConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  REVOKED
}

enum GmailSyncStatus {
  IDLE
  SYNCING
  FAILED
}

enum BlockSource {
  DELETE
  MENU
}

/// A company whose new mail the app does not read (owner, 26 Oct 2026). Sync skips its mail
/// before saving anything; mail that came while blocked is not fetched after an unblock.
model BlockedSender {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  /// The whole company domain, such as infosys.com (`contracts/blockedSender.ts`).
  domain    String
  source    BlockSource
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@map("blocked_senders")
}

model GmailConnection {
  id                     String                @id @default(uuid()) @db.Uuid
  userId                 String                @unique @db.Uuid
  gmailEmail             String
  status                 GmailConnectionStatus @default(NOT_CONNECTED)
  syncStatus             GmailSyncStatus       @default(IDLE)
  accessTokenExpiresAt   DateTime?
  accessToken            String
  refreshToken           String?
  /// True when the saved Google grant also allows sending mail (replies from the app).
  canSend                Boolean               @default(false)
  lastHistoryId          String?
  lastSyncedAt           DateTime?
  syncClaim              String?
  syncLeaseUntil         DateTime?
  syncError              String?
  syncLookbackDays       Int                   @default(1)
  unscannedFrom          DateTime?
  unscannedUntil         DateTime?
  lastSyncedLookbackDays Int?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gmail_connections")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@map("session")
}

enum AIProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AIRelevanceDecision {
  RELEVANT
  IRRELEVANT
  UNCERTAIN
}

enum EmailCategory {
  RECRUITER
  INTERVIEW
  ASSESSMENT
  OFFER
  REJECTION
  FOLLOW_UP
  NEWSLETTER
  SPAM
}

model AIProcessingResult {
  id                String               @id @default(uuid()) @db.Uuid
  emailId           String               @unique @db.Uuid
  provider          String
  model             String
  contractVersion   String
  processingStatus  AIProcessingStatus   @default(PENDING)
  relevanceDecision AIRelevanceDecision?
  category          EmailCategory?
  confidence        Float?
  deterministic     Boolean              @default(false)

  companyName        String?
  jobTitle           String?
  recruiterName      String?
  recruiterEmail     String?
  interviewStage     String?
  interviewType      String?
  interviewDate      String?
  interviewTime      String?
  assessmentInfo     String?
  assessmentDeadline String?
  offerInfo          String?
  rejectionInfo      String?
  actionRequired     Boolean?
  requestedAction    String?
  actionDeadline     String?
  followUpRequired   Boolean?
  followUpDate       String?
  /// Set when the email asks for money or bank, card or ID details to get or keep a job: the
  /// signs the AI saw. The app then shows a safe next step instead of the email's request.
  fakeOfferWarning   String?
  /// How the user does the request (extraction v6 and v7); null before them or with no request.
  askKind            AskKind?
  /// Short replies the user could send, when the mail expects an answer by mail (at most 3).
  replyChoices       String[] @default([])

  scheduleCandidates   Json?
  extractionConfidence Float?
  provenance           String?

  errorCategory String?
  errorDetails  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([processingStatus])
  @@map("ai_processing_results")
}

enum RetiredReason {
  EMAIL_MOVED
  EMAIL_UNLINKED
}

model ApplicationEvent {
  retiredAt            DateTime?
  retiredReason        RetiredReason?
  id                   String             @id @default(uuid()) @db.Uuid
  applicationId        String             @db.Uuid
  emailId              String?            @db.Uuid // nullable to allow manual events later
  type                 String // e.g., 'STATE_INFERRED', 'NOTE_ADDED'
  oldState             ApplicationStatus?
  newState             ApplicationStatus?
  description          String?
  provenance           String? // to track why this event was created
  /// Set only on AUTOMATION_SUBMITTED events: one event per submission (ADR-0002 decision 6).
  externalSubmissionId String?            @unique @db.Uuid

  createdAt DateTime @default(now())

  application        Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  email              Email?              @relation(fields: [emailId], references: [id], onDelete: SetNull)
  externalSubmission ExternalSubmission? @relation(fields: [externalSubmissionId], references: [id], onDelete: SetNull)

  @@unique([applicationId, emailId, type])
  @@index([applicationId])
  @@index([emailId])
  @@map("application_events")
}

/// Who changed the status the user sees.
enum StatusChangeSource {
  AI
  USER
}

/// One change of an application's status as the user sees it (`userStatus ?? aiStatus`), kept for
/// the Dashboard (owner, 27 Oct 2026): the furthest step a job reached, even when it was rejected
/// later. Ids, steps and times only, never mail text.
model StatusChange {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  /// The mail behind an AI change; null for the user's change or a recount after a mail left.
  emailId       String?            @db.Uuid
  source        StatusChangeSource
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus?
  /// When it happened: the mail's receivedAt for the AI, the click for the user.
  changedAt     DateTime
  /// Set when the mail behind it moved to another application or was unlinked.
  retiredAt     DateTime?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  email       Email?      @relation(fields: [emailId], references: [id], onDelete: SetNull)

  @@index([applicationId, changedAt])
  @@index([emailId])
  @@map("status_changes")
}

enum DeadlinePrecision {
  DATE
  DATETIME
}

model Action {
  origin              String?
  actionRevision      Int                @default(0)
  clientRequestId     String?            @unique @db.Uuid
  creationPayloadHash String?
  snoozedUntil        DateTime?
  retiredAt           DateTime?
  retiredReason       RetiredReason?
  deadlinePrecision   DeadlinePrecision?
  id                  String             @id @default(uuid()) @db.Uuid
  applicationId       String             @db.Uuid
  emailId             String?            @db.Uuid
  type                String // e.g., 'ACTION_REQUIRED', 'FOLLOW_UP_REQUIRED'
  description         String? // e.g. "Send thank you note"
  deadline            DateTime?
  status              String             @default("PENDING") // e.g., 'PENDING', 'COMPLETED', 'DISMISSED'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  email       Email?      @relation(fields: [emailId], references: [id], onDelete: SetNull)

  notificationDeliveries NotificationDelivery[]

  @@unique([applicationId, emailId, type])
  @@index([applicationId])
  @@index([emailId])
  @@map("actions")
}

enum NotificationProviderType {
  DISCORD
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED_RETRYABLE
  FAILED_PERMANENT
}

model NotificationDelivery {
  id            String                   @id @default(uuid()) @db.Uuid
  actionId      String                   @db.Uuid
  provider      NotificationProviderType
  status        NotificationStatus       @default(PENDING)
  attemptCount  Int                      @default(0)
  lastAttemptAt DateTime?
  claimedAt     DateTime?
  errorDetails  String?
  createdAt     DateTime                 @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, provider])
  @@index([status])
  @@map("notification_deliveries")
}

enum AIOperationStatus {
  PENDING
  PROCESSING
  COMPLETED
  RETRYABLE
  FAILED
  UNKNOWN
}

// A claim is committed BEFORE the external effect. A lost/uncertain response
// is never automatically reclaimed: an operator must reconcile it first.
enum AIBatchStatus {
  PROCESSING
  COMPLETED
  REFUSED
  FAILED
  UNKNOWN
}

model AIBatch {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  operation    String
  version      String
  status       AIBatchStatus
  itemCount    Int
  provider     String?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  errorCode    String?
  startedAt    DateTime
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  operations AIOperation[]

  @@index([userId, createdAt])
  @@map("ai_batches")
}

model AIOperation {
  id              String            @id @default(uuid()) @db.Uuid
  emailId         String            @db.Uuid
  operation       String
  version         String
  status          AIOperationStatus @default(PENDING)
  attempts        Int               @default(0)
  /// Catalog provider and model of the latest claimed call: provenance of the result, and where
  /// an uncertain charge happened. Metadata only (ADR-0001 decision 12).
  provider        String?
  model           String?
  /// Each explicit user approval permits exactly one more call (ADR-0001 decision 10).
  approvedRetries Int               @default(0)
  batchId         String?           @db.Uuid
  result          Json?
  errorCode       String?
  /// The exact last failure of this step: status, the provider's short code, the model and our own
  /// times (contract AIFailure). Allowlisted tokens only, never the provider's message text.
  lastFailure     Json?
  /// When each counted try was sent, oldest first. A refusal gives its try back and is not kept.
  triedAt         DateTime[]        @default([])
  retryAfter      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  email           Email             @relation(fields: [emailId], references: [id], onDelete: Cascade)
  batch           AIBatch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([emailId, operation, version])
  @@index([status, retryAfter])
  @@index([batchId])
  /// The reading status counts the mails finished in the last minutes, for all users together.
  @@index([completedAt])
  @@map("ai_operations")
}

// One durable counter for each UTC day. Limits apply across users/workers.
model AICallBudget {
  day           String    @id
  calls         Int       @default(0)
  cooldownUntil DateTime?

  @@map("ai_call_budgets")
}

// ─── User-provided AI (ADR-0001) ─────────────────────────────────────────────

/// Why a user's AI access cannot be used now. Needs attention, on the configuration: KEY_REJECTED,
/// ACCOUNT_OR_BILLING, MODEL_UNAVAILABLE, KEY_UNREADABLE (stored key cannot be decrypted; re-enter
/// it). A model's pause, on AIModelPause: RATE_LIMITED, PROVIDER_BUSY (the provider answered that
/// it is overloaded, or did not answer in time), PROVIDER_UNAVAILABLE (older pauses only).
enum AIAccessIssue {
  KEY_REJECTED
  ACCOUNT_OR_BILLING
  MODEL_UNAVAILABLE
  KEY_UNREADABLE
  RATE_LIMITED
  PROVIDER_UNAVAILABLE
  PROVIDER_BUSY
}

/// The user's active AI setup (ADR-0001 decision 5): all AI work runs on it. The key is write-only
/// AES-256-GCM ciphertext bound to the user; it is selected only where a provider call or
/// verification needs it. Other connected providers wait in AISavedProvider.
model AIConfiguration {
  userId            String         @id @db.Uuid
  /// Catalog provider ID (code catalog, not a database catalog).
  provider          String
  /// null only for the free AI ('career-companion'), which runs on Career Companion's own key.
  encryptedApiKey   String?
  /// null follows the catalog's recommended model for the role.
  fastModel         String?
  detailedModel     String?
  accessIssue       AIAccessIssue?
  accessIssueModel  String?
  /// The exact failure behind a key, billing or model problem (contract AIFailure).
  accessFailure     Json?
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  /// Catalog disclosure version the user agreed to, and when.
  consentDisclosure String
  consentedAt       DateTime
  /// Incremented on every save; job-side state writes are conditional on it.
  revision          Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pauses AIModelPause[]

  @@map("ai_configurations")
}

/// A connected provider that is not the active one (ADR-0001 decision 5, owner 22 Oct 2026). With
/// the active setup, a user holds at most one key per provider. It does no AI work: only a check, a
/// key change or a model change the user starts calls the provider. Making it active moves it into
/// AIConfiguration, and the active setup it replaces moves here.
model AISavedProvider {
  userId            String         @db.Uuid
  /// Catalog provider ID.
  provider          String
  /// null only for the free AI ('career-companion').
  encryptedApiKey   String?
  /// null follows the catalog's recommended model for the role.
  fastModel         String?
  detailedModel     String?
  /// A key, billing or model problem found by the last check (never a pause).
  accessIssue       AIAccessIssue?
  accessIssueModel  String?
  accessFailure     Json?
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  consentDisclosure String
  consentedAt       DateTime
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, provider])
  @@map("ai_saved_providers")
}

/// One model's pause for one user: the provider was busy, limited the key, or did not answer in
/// time. Each model pauses on its own; a success on the model removes its row. Survives the UTC
/// day boundary. Pauses belong to the active setup: making another provider active removes them.
model AIModelPause {
  userId              String          @db.Uuid
  /// Catalog model ID.
  model               String
  reason              AIAccessIssue
  resumesAt           DateTime?
  /// Failures in a row on this model: each makes the next pause longer.
  consecutiveFailures Int             @default(0)
  /// The waiting mail "Read waiting mails now" sent as a test, when, and how it failed (null while
  /// it runs). Only the test mail may use the model until it answers.
  testEmailId         String?         @db.Uuid
  testStartedAt       DateTime?
  testResult          String?
  /// The exact failure that started or last extended the pause (contract AIFailure).
  lastFailure         Json?
  configuration       AIConfiguration @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, model])
  @@map("ai_model_pauses")
}

/// One model's pause on the free AI (owner, 24 Oct 2026), shared by every user on it: OpenRouter was
/// busy or limited Career Companion's key, the key's credit ran out, or the key or the model failed.
/// A success on the model removes its row.
model FreeAIPause {
  /// Catalog model ID.
  model               String        @id
  reason              AIAccessIssue
  resumesAt           DateTime
  /// Busy answers in a row: each makes the next pause longer.
  consecutiveFailures Int           @default(1)
  /// The exact failure that started or last extended the pause (contract AIFailure).
  lastFailure         Json?
  /// When the owner was told about a credit, key or model problem; null until then.
  alertedAt           DateTime?
  updatedAt           DateTime      @updatedAt

  @@map("free_ai_pauses")
}

/// Career Companion's own per-user counts for one UTC day. `calls` is the safety limit counter.
/// Not provider quota or billing data.
model AIUsageDay {
  userId        String @db.Uuid
  day           String
  calls         Int    @default(0)
  inputTokens   Int    @default(0)
  outputTokens  Int    @default(0)
  verifications Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("ai_usage_days")
}

/// The Dashboard's AI tip (owner, 27 Oct 2026): the latest one for the user, made from their
/// numbers at most once a day and only when the numbers changed. Opening the page never calls AI.
model DashboardAITip {
  userId      String    @id @db.Uuid
  /// The latest tip; null until one was made.
  text        String?
  /// The catalog model that wrote it.
  model       String?
  provider    String?
  madeAt      DateTime?
  /// A fingerprint of the numbers the latest tip was made from.
  numbersHash String?
  /// The last try, made or not: the next one waits a day.
  triedAt     DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dashboard_ai_tips")
}

// ─── Automation submissions through MCP (ADR-0002) ───────────────────────────

/// A per-user bearer token for the MCP endpoint. Only the SHA-256 hash and a display prefix are
/// stored; the plaintext is shown once at creation. Revoking keeps the row for the audit trail.
model IntegrationToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  name          String
  tokenHash     String    @unique
  displayPrefix String
  /// Single scope in v1 (ADR-0002 decision 10).
  scope         String    @default("submissions:write")
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  lastUsedAt    DateTime?
  revokedAt     DateTime?

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions      ExternalSubmission[]
  notSubmittedJobs NotSubmittedJob[]

  @@index([userId, createdAt])
  @@map("integration_tokens")
}

enum ExternalSubmissionSource {
  AUTOMATION
}

enum ExternalSubmissionMatchState {
  NEEDS_REVIEW
  LINKED
  CREATED
  IGNORED
}

/// Who settled a submission's match. Rule-based matching is AUTOMATIC: no AI makes this decision,
/// so the Gmail MatchConfirmationSource (AI_AUTO) is deliberately not reused.
enum SubmissionResolvedBy {
  AUTOMATIC
  USER
}

/// Evidence that the user's automation reported a confirmed submission (ADR-0002 decision 6).
/// A later call for the same entry fills only empty fields and never changes a saved value
/// (amendment of 21 Oct 2026). The match fields change once, on resolution.
model ExternalSubmission {
  id               String                       @id @default(uuid()) @db.Uuid
  userId           String                       @db.Uuid
  source           ExternalSubmissionSource
  /// `YYYY-MM-DD/HH:MM:SS` from the automation's daily file; the idempotency key.
  sourceRecordRef  String
  platform         String
  company          String
  jobTitle         String
  submittedAt      DateTime
  jobUrl           String?
  portalJobId      String?
  destinationHost  String?
  discoverySource  String?
  location         String?
  workMode         String?
  confirmationText String?
  /// Full http/https URL of the page where the form was submitted.
  applyUrl         String?
  resumeFilename   String?
  /// [{ question, answer }] as written in the daily file; null when none were reported.
  submittedAnswers Json?
  receivedAt       DateTime                     @default(now())
  tokenId          String?                      @db.Uuid
  matchState       ExternalSubmissionMatchState
  /// null while NEEDS_REVIEW.
  resolvedBy       SubmissionResolvedBy?
  applicationId    String?                      @db.Uuid
  /// null while NEEDS_REVIEW.
  resolvedAt       DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       IntegrationToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  application Application?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  event       ApplicationEvent?

  @@unique([userId, source, sourceRecordRef])
  @@index([userId, matchState])
  @@index([userId, receivedAt])
  @@index([applicationId])
  @@map("external_submissions")
}

enum NotSubmittedOutcome {
  SKIPPED
  NEEDS_USER
}

/// A job the user's automation looked at but did not apply to (`skipped` or `needs_user` in its
/// daily file). Never an application. Same entry key and fill-only-empty rule as ExternalSubmission.
model NotSubmittedJob {
  id              String                   @id @default(uuid()) @db.Uuid
  userId          String                   @db.Uuid
  source          ExternalSubmissionSource
  /// `YYYY-MM-DD/HH:MM:SS` from the automation's daily file; the idempotency key.
  sourceRecordRef String
  outcome         NotSubmittedOutcome
  platform        String
  company         String
  jobTitle        String
  jobUrl          String?
  reason          String
  /// When the automation wrote the entry.
  loggedAt        DateTime
  receivedAt      DateTime                 @default(now())
  tokenId         String?                  @db.Uuid

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  token IntegrationToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@unique([userId, source, sourceRecordRef])
  @@index([userId, loggedAt])
  @@index([userId, receivedAt])
  @@map("not_submitted_jobs")
}

enum AgendaState {
  TENTATIVE
  CONFIRMED
  CANCELLED
  COMPLETED
}

model AgendaItem {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  applicationId     String         @db.Uuid
  emailId           String         @db.Uuid
  candidateKey      String
  extractionVersion String
  suggestion        Json
  userTiming        Json?
  // Materialized effective timing for bounded, database-side pagination.
  precision         String
  date              String?
  instant           DateTime?
  state             AgendaState    @default(TENTATIVE)
  revision          Int            @default(0)
  decisionSourceId  String?        @db.Uuid
  retiredAt         DateTime?
  retiredReason     RetiredReason?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  application       Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  email             Email          @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([applicationId, emailId, candidateKey])
  @@index([userId, state, date])
  @@map("agenda_items")
}
