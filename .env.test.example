# Dedicated EMPTY fixture DB only: tests delete rows without per-user scoping.
# Both URLs must be identical. Local host only (localhost, 127.0.0.1, [::1]),
# database career_companion_*test, with no query except schema=public.
# For smoke: copy to .env.smoke.test, use a separate *_smoke_test DB,
# and pass TEST_ENV_FILE=.env.smoke.test to scripts/guarded-migrate.cjs.
DATABASE_URL=postgresql://cc_ci:cc_ci_fixture_only@localhost:5432/career_companion_ci_test?schema=public
TEST_DATABASE_URL=postgresql://cc_ci:cc_ci_fixture_only@localhost:5432/career_companion_ci_test?schema=public
NODE_ENV=test
ENABLE_DEV_AUTH=true
SESSION_SECRET=fixture-session-secret-only
OAUTH_STATE_COOKIE_SECRET=fixture-cookie-secret-only
GMAIL_CLIENT_ID=ci-fake-gmail-client-id
GMAIL_CLIENT_SECRET=ci-fake-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:5173/api/gmail/callback
GOOGLE_CLIENT_ID=ci-fake-google-client-id
GOOGLE_CLIENT_SECRET=ci-fake-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/callback
# 64 hex, fixture only, must differ: openssl rand -hex 32
GMAIL_TOKEN_ENCRYPTION_KEY=
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_USER_DAILY_CALL_LIMIT=100
AI_TRIAGE_BATCH_ENABLED=
AI_TRIAGE_BATCH_SIZE=20
DISCORD_WEBHOOK_URL=
DISCORD_USER_ID=
FRONTEND_URL=http://localhost:5173

GMAIL_SCHEDULED_SYNC_ENABLED=true
GMAIL_SCHEDULED_SYNC_TZ=Asia/Kolkata
