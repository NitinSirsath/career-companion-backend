{
  "name": "career-companion-backend",
  "version": "1.0.0",
  "description": "Backend API for Career Companion.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NitinSirsath/career-companion-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/NitinSirsath/career-companion-backend/issues"
  },
  "homepage": "https://github.com/NitinSirsath/career-companion-backend#readme",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "prisma": {
    "seed": "ts-node-dev prisma/seed.ts"
  }
}
