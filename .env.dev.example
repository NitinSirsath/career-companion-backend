# Dev mode: manual testing with made-up mail. No Google account, no real Gmail, never live data.
# `npm run devmode` copies this file to .env.dev on first run, fills in the four secrets, creates
# the database and starts the backend. Prod mode uses .env instead (see .env.example).
# Every setting is listed here, also the empty ones, so nothing is taken from a neighbouring .env.
APP_MODE=dev

# Not needed in dev mode: every user here uses the mail sandbox. See .env.example.
TEST_ACCOUNTS=

PORT=3000

# Written out in full. The database name must end in _dev; it is created when missing.
# The default matches `npm run db:up`. Change user, password or port to match your PostgreSQL.
DATABASE_URL=postgresql://career_companion:career_companion_password@localhost:5432/career_companion_dev?schema=public

FRONTEND_URL=http://localhost:5173
LOG_LEVEL=

# Filled in with fresh random values on first run. The two encryption keys must differ.
SESSION_SECRET=
OAUTH_STATE_COOKIE_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
AI_CREDENTIAL_ENCRYPTION_KEY=

# Dev mode uses no Google account. Leave these empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# AI is real: each test user adds their own provider key in the app (AI provider page).
RELEVANCE_CONFIDENCE_THRESHOLD=0.7
AI_TRIAGE_BATCH_ENABLED=
AI_TRIAGE_BATCH_SIZE=20
AI_USER_DAILY_CALL_LIMIT=500
# Not needed in dev mode: every provider is offered outside production. See .env.example.
AI_SHOW_HIDDEN_PROVIDERS=
AGENDA_EXTRACTION_V3_ENABLED=false

DISCORD_WEBHOOK_URL=
DISCORD_USER_ID=
TRUST_PROXY_HOPS=

MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_DAILY_SUBMISSION_LIMIT=500

GMAIL_SCHEDULED_SYNC_ENABLED=true
GMAIL_SCHEDULED_SYNC_TZ=Asia/Kolkata
