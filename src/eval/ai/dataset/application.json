[
  {
    "id": "application-received-ats",
    "input": {
      "sender": "Tailspin Careers <no-reply@jobs.tailspin.example.com>",
      "subject": "We received your application for Product Designer",
      "labels": [
        "INBOX",
        "CATEGORY_UPDATES"
      ],
      "body": "Hi Alex,\n\nThanks for applying for the Product Designer position at Tailspin Toys. Our team will review your application\nand contact you if your experience matches our needs. This usually takes up to two weeks.\n\nTailspin Toys Recruiting"
    },
    "expect": {
      "relevance": "RELEVANT",
      "fields": {
        "companyName": {
          "contains": [
            "tailspin"
          ]
        },
        "jobTitle": {
          "contains": [
            "product designer"
          ]
        }
      },
      "mustBeNull": [
        "offerInfo",
        "rejectionInfo",
        "interviewDate",
        "assessmentDeadline"
      ]
    },
    "group": "application"
  },
