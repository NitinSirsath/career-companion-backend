# Application Port
PORT=3000

# PostgreSQL Configuration
POSTGRES_USER=career_companion
POSTGRES_PASSWORD=career_companion_password
POSTGRES_DB=career_companion_db
POSTGRES_PORT=5432

# Prisma Database URL
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"


# Frontend origin (used for CORS and post-OAuth redirects)
FRONTEND_URL=http://localhost:5173

# ─── Google OAuth (COM-24) ───────────────────────────────────────────────────
# Obtain from Google Cloud Console. Google login keys are required for local development and production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Session signing secret — required. Use a strong random value; never commit a real value.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Secret for signing OAuth state cookies (CSRF protection).
# Any random string; use a strong value in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_COOKIE_SECRET=

# ─── Gmail OAuth (COM-19) ───────────────────────────────────────────────────
# Obtain from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must match the Authorized redirect URI configured in Google Cloud Console.
GMAIL_REDIRECT_URI=http://localhost:5173/api/gmail/callback

# AES-256-GCM token encryption key — 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit a real value to version control.
GMAIL_TOKEN_ENCRYPTION_KEY=

# ─── User-provided AI keys (ADR-0001) ────────────────────────────────────────
# Dedicated AES-256-GCM key for users' AI provider keys — 64 hex characters (32 bytes).
# Must differ from GMAIL_TOKEN_ENCRYPTION_KEY. Back it up: losing it makes stored AI keys unreadable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_CREDENTIAL_ENCRYPTION_KEY=

# ─── AI processing (ADR-0001) ────────────────────────────────────────────────
# There is no server AI key: each user connects their own provider in the app (AI provider page).
RELEVANCE_CONFIDENCE_THRESHOLD=0.7
# Batch initial relevance triage. Empty/unset/false = off; only true enables it.
AI_TRIAGE_BATCH_ENABLED=
# 1-25, default 20.
AI_TRIAGE_BATCH_SIZE=20

# ─── Discord Integrations ───────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# Career Companion's per-user AI safety limit: maximum AI calls made for one user per UTC day
# (0-5000, default 500). An application safeguard against defects and loops, not the provider's
# quota or billing. 0 pauses all AI calls for everyone (operator kill switch).
AI_USER_DAILY_CALL_LIMIT=500
# Owner of DISCORD_WEBHOOK_URL. Notifications for every other user are skipped.
# Leave empty to disable delivery until ownership is configured.
DISCORD_USER_ID=
# Set only to the exact number of trusted reverse-proxy hops in your deployment.
TRUST_PROXY_HOPS=

# ─── Automation submissions through MCP (ADR-0002) ───────────────────────────
# POST /mcp accepts only per-user integration tokens (created on the app's Automation page).
# Hostnames (no scheme or port) the Host header may name for /mcp. Defaults to localhost outside
# production; production refuses to start without it. Behind CloudFront/ALB, list the Host the
# backend actually receives.
MCP_ALLOWED_HOSTS=
# Hostnames a present Origin header may name. Default empty: any Origin is rejected and requests
# without one pass. Only set this if an MCP client sends an Origin (record it in MCP-09).
MCP_ALLOWED_ORIGINS=
# New automation submissions per user per UTC day (0-5000, default 500). 0 stops all new submissions.
MCP_DAILY_SUBMISSION_LIMIT=500

GMAIL_SCHEDULED_SYNC_ENABLED=true
GMAIL_SCHEDULED_SYNC_TZ=Asia/Kolkata

# Default-off until extraction/v3 qualification. Disable only stops new selection/projection.
AGENDA_EXTRACTION_V3_ENABLED=false
