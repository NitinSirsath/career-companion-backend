# Application Port
PORT=3000

# PostgreSQL Configuration
POSTGRES_USER=career_companion
POSTGRES_PASSWORD=career_companion_password
POSTGRES_DB=career_companion_db
POSTGRES_PORT=5432

# Prisma Database URL
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Required in future issues:
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
