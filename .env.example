# Application Port
PORT=3000

# PostgreSQL Configuration
POSTGRES_USER=career_companion
POSTGRES_PASSWORD=career_companion_password
POSTGRES_DB=career_companion_db
POSTGRES_PORT=5432

# Prisma Database URL
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Development Authentication
ENABLE_DEV_AUTH=true

# Frontend origin (used for CORS and post-OAuth redirects)
FRONTEND_URL=http://localhost:5173

# ─── Gmail OAuth (COM-19) ───────────────────────────────────────────────────
# Obtain from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must match the Authorized redirect URI configured in Google Cloud Console.
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# AES-256-GCM token encryption key — 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit a real value to version control.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Secret for signing OAuth state cookies (CSRF protection).
# Any random string; use a strong value in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_COOKIE_SECRET=

# ─── Google OAuth (COM-24) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
SESSION_SECRET=

# ─── Gemini AI (COM-26) ──────────────────────────────────────────────────────
# NEVER EXPOSE THIS KEY TO THE FRONTEND
GEMINI_API_KEY=
GEMINI_RELEVANCE_MODEL=gemini-2.5-flash-lite
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
